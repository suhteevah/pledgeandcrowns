# Pledge & Crown compile API - environment template.
# Copy to /etc/pnc-compile/env (root:pnc-compile, mode 0640) and fill in.
# Every variable is optional; the value shown is the default unless noted.

# Listen address. Keep loopback and put a TLS reverse proxy in front.
# A non-loopback bind is REFUSED at startup unless PNC_AUTH_TOKENS is set.
PNC_BIND=127.0.0.1:7878

# Comma-separated bearer tokens (>= 32 chars each). Required on /compile,
# /compile-real and /metrics when set; /health stays open. Two entries let
# you rotate without downtime. Generate with: openssl rand -hex 32
# No default - REQUIRED for production.
PNC_AUTH_TOKENS=

# Comma-separated exact browser origins allowed by CORS (no wildcards, no
# trailing slash). Default is the local web-serve dev server only.
# Production example (web build + Tauri webviews):
#   PNC_CORS_ORIGINS=https://play.example.com,tauri://localhost,http://tauri.localhost
PNC_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Use the right-most X-Forwarded-For entry as the client IP for rate
# limiting. Set to true ONLY when every request comes through your own
# reverse proxy (i.e. PNC_BIND is loopback). Otherwise clients can spoof it.
PNC_TRUST_PROXY=false

# Per-client-IP token buckets (IPv6 keyed by /64).
PNC_RATE_LIMIT_PER_MIN=600
PNC_REAL_RATE_LIMIT_PER_MIN=20

# Real-build backpressure: concurrent cargo builds, and how many more may
# wait for a slot before /compile-real answers 503 + Retry-After.
PNC_MAX_CONCURRENT_BUILDS=2
PNC_MAX_QUEUED_BUILDS=8

# Linear-memory cap for each sandboxed wasm run, in MiB (1..=128).
PNC_RUN_MEMORY_MIB=16

# Log filter (tracing EnvFilter syntax).
RUST_LOG=pledge_compile_api=debug,tower_http=info
