# SPDX-License-Identifier: AGPL-3.0-or-later
# Pledge & Crown compile API (pnc-compile-api.service) - environment template.
# Copy to /etc/pnc-compile/env with owner root:root and mode 0600 (systemd
# reads it as root; neither pnc-api nor pnc-builder can read it). ONLY the
# API unit references this file. Every variable is optional unless noted;
# the value shown is the default unless noted.

# Listen address. Keep loopback and put a TLS reverse proxy in front.
# A non-loopback bind is REFUSED at startup unless PNC_AUTH_TOKENS is set.
PNC_BIND=127.0.0.1:7878

# /metrics listener. Must be loopback (refused otherwise) and is never
# proxied: Caddy forwards to PNC_BIND only.
PNC_METRICS_BIND=127.0.0.1:9878

# Comma-separated bearer tokens (>= 32 chars each) for /compile and
# /compile-real; /health stays open. Two entries let you rotate without
# downtime. Generate with: openssl rand -hex 32
# No default - REQUIRED for production.
PNC_AUTH_TOKENS=

# Comma-separated tokens accepted ONLY on /metrics (player tokens are not).
# Unset: /metrics answers only direct loopback clients.
PNC_METRICS_TOKENS=

# Comma-separated exact browser origins allowed by CORS (no wildcards, no
# trailing slash). Default is the local web-serve dev server only.
# Production example (web build + Tauri webviews):
#   PNC_CORS_ORIGINS=https://play.example.com,tauri://localhost,http://tauri.localhost
PNC_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Use the right-most X-Forwarded-For entry as the client IP for rate
# limiting. Set to true ONLY when every request comes through your own
# reverse proxy. Refused with a non-loopback PNC_BIND unless
# PNC_ALLOW_TRUST_PROXY_PUBLIC_BIND=true (only if a firewall guarantees
# that only the proxy can reach the port).
PNC_TRUST_PROXY=false
PNC_ALLOW_TRUST_PROXY_PUBLIC_BIND=false

# Per-client-IP token buckets (IPv6 keyed by /64, plus a 16x aggregate per
# /48). When a table holds PNC_RATE_LIMIT_MAX_CLIENTS clients, the global
# limiter lets new clients through untracked (counted in
# pnc_rate_limit_fail_open_total) and /compile-real evicts the least
# recently seen clients.
PNC_RATE_LIMIT_PER_MIN=600
PNC_REAL_RATE_LIMIT_PER_MIN=20
PNC_RATE_LIMIT_MAX_CLIENTS=100000

# Real-build backpressure: concurrent builds, and how many more may wait
# for a slot before /compile-real answers 503 + Retry-After. Keep
# PNC_MAX_CONCURRENT_BUILDS <= the builder's PNC_BUILDER_MAX_JOBS (a full
# builder also answers 503).
PNC_MAX_CONCURRENT_BUILDS=2
PNC_MAX_QUEUED_BUILDS=8

# Linear-memory cap for each sandboxed wasm run, in MiB (1..=128).
PNC_RUN_MEMORY_MIB=16

# Slow-client limits: request line + headers, whole body, whole request
# (queue wait + build included; minimum 70 s, above the 65 s builder reply
# budget).
PNC_HEADER_READ_TIMEOUT_SECS=10
PNC_BODY_READ_TIMEOUT_SECS=15
PNC_REQUEST_DEADLINE_SECS=120

# ---- Where player code runs -------------------------------------------------
# The unit file sets PNC_BUILDER_SOCKET=/run/pnc-builder/builder.sock, so
# builds go to pnc-builder.service. Do NOT unset it on a server: without it
# the config refuses to start whenever tokens are configured, the bind is
# public, or PNC_TRUST_PROXY is on.
# PNC_BUILDER_SOCKET=/run/pnc-builder/builder.sock

# Second-layer deny-list for compile-time file reads. Refused as false on
# any exposed config. (The builder applies it again regardless.)
PNC_SOURCE_DENYLIST=true

# LOCAL DEV ONLY, refused on a non-loopback bind: allows in-process and
# unsandboxed builds with tokens / trust-proxy set. Never set on a server.
PNC_DEV_UNSAFE_LOCAL_BUILDS=false

# Log filter (tracing EnvFilter syntax).
RUST_LOG=pledge_compile_api=debug,tower_http=info
