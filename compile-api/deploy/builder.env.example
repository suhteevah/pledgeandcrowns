# Pledge & Crown builder (pnc-builder.service) - environment template.
# Copy to /etc/pnc-builder/builder.env, owner root:root, mode 0644.
# NOTHING SECRET GOES HERE: the builder refuses to start if PNC_AUTH_TOKENS
# or PNC_METRICS_TOKENS is set. deploy/verify-sandbox.sh reads this file to
# run its probes with exactly the builder's sandbox settings.
# One KEY=VALUE per line, no quotes, no spaces around `=`.

# bwrap is the default on Linux and the only accepted mode in production
# (`none` needs PNC_DEV_UNSAFE_LOCAL_BUILDS=true, local dev only).
PNC_BUILD_SANDBOX=bwrap
# Toolchain root for the pinned rustc (`pledge_compile_api toolchain`):
# contains bin/cargo, bin/rustc, lib/rustlib/wasm32-wasip1. Must be under
# /opt/pnc: the builder unit hides the rest of /opt (README step 4).
PNC_TOOLCHAIN_DIR=/opt/pnc/toolchains/1.99.0-x86_64-unknown-linux-gnu
PNC_BWRAP_PATH=/usr/bin/bwrap
PNC_PRLIMIT_PATH=/usr/bin/prlimit
# /proc inside the sandbox: none (default; keeps the unit's proc
# protections usable) or fresh (--proc /proc; then remove ProtectProc=,
# ProtectKernelTunables= and ProtectKernelLogs= from pnc-builder.service).
PNC_BWRAP_PROC=none
# Per-build RLIMIT_AS in MiB (512..=1408; below the unit's MemoryMax=1536M).
PNC_BUILD_ADDRESS_SPACE_MIB=1280
# Concurrent jobs (1..=64). Keep >= the API's PNC_MAX_CONCURRENT_BUILDS.
PNC_BUILDER_MAX_JOBS=2
# Parent of per-job dirs (default <PrivateTmp>/pledge-wasm-builder).
# PNC_BUILD_ROOT=

RUST_LOG=pledge_compile_api=debug
